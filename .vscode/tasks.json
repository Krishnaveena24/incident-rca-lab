{
  "version": "2.0.0",
  "inputs": [
    { "id": "case", "type": "pickString", "description": "Incident case",
      "options": ["1", "2", "3", "4", "5"] }
  ],
  "tasks": [
    { "label": "Lab: Start",        "type": "shell", "command": "docker compose up -d --build && docker compose ps", "problemMatcher": [] },
    { "label": "Lab: Status",       "type": "shell", "command": "docker compose ps -a && curl -s http://localhost:8080/health", "problemMatcher": [] },
    { "label": "Lab: Tail API log", "type": "shell", "command": "tail -f logs/api/api.log", "isBackground": true, "problemMatcher": [] },
    { "label": "Lab: Inject case",  "type": "shell", "command": "./scripts/chaos.sh inject ${input:case}", "problemMatcher": [] },
    { "label": "Lab: Fix case",     "type": "shell", "command": "./scripts/chaos.sh fix ${input:case}", "problemMatcher": [] },
    { "label": "Lab: Diagnose",     "type": "shell", "command": "./scripts/diagnose.sh case${input:case}", "problemMatcher": [] },
    { "label": "Lab: Load test search", "type": "shell", "command": "./scripts/load.sh search 40 10", "problemMatcher": [] },
    { "label": "Lab: MySQL shell",  "type": "shell", "command": "docker compose exec mysql mysql -uroot -prootpass shopdb", "problemMatcher": [] },
    { "label": "Lab: Stop",         "type": "shell", "command": "docker compose down", "problemMatcher": [] },
    { "label": "Lab: Reset (delete DB data)", "type": "shell", "command": "docker compose down -v && rm -f logs/api/*.log", "problemMatcher": [] }
  ]
}
