                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('DB is up', () => pm.expect(pm.response.json().db).to.eql('up'));",
                  "pm.test('Response time < 500 ms', () => pm.expect(pm.response.responseTime).to.be.below(500));",
